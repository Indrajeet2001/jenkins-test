
pipeline {
    agent any

    tools {
        mvn 'Maven'
        jdk 'JAVA '
    }

    stages {
        stage('Checkout') {
            steps {
                git branch : 'main',
                url : 'https://github.com/Indrajeet2001/maven-temp.git'
                bat 'java --version'
                bat 'mvn --verison'
            }
        }
        stage('Build') {
            steps {
                bat 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'mvn test'
            }
        }

        stage('Package') {
            steps {
                echo 'mvn test'
            }
        }

        stage('Run Application') {
            steps {
                bat 'java -cp target/maven-demo-1.0-SNAPSHOT.jar com.example.App'
            }
        }
        stage('Archive Artifact')
            steps {
                archiveArtifacts artifacts : 'target/*.jar',
                                 fingerprint : true
            }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed! Check the Console Output.'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
